{
  "name": "selfcrm",
  "private": true,
  "version": "1.7.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p worker/tsconfig.json --noEmit",
    "bump": "node scripts/bump-version.mjs",
    "bot": "node scripts/telegram-bot.mjs",
    "bot:setup": "node scripts/telegram-bot.mjs --setup",
    "bot:webhook:set": "node scripts/set-webhook.mjs --set",
    "bot:webhook:info": "node scripts/set-webhook.mjs --info",
    "bot:webhook:delete": "node scripts/set-webhook.mjs --delete",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "worker:check": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.1",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3",
    "pdfmake": "^0.3.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.21",
    "vitest": "^2.1.9",
    "wrangler": "^4.141.0"
  }
}
