# Дадата: API-ключ для подсказок адресов (suggest/address).
#
# Ключ НЕ хранится в исходниках: он подставляется в бандл на этапе сборки.
# Значение по умолчанию в коде отсутствует, поэтому без этой переменной подсказки
# адресов работают только по локальной базе (Settings → База адресов).
#
# Как задать:
#   - локально: файл .env или .env.local (оба не коммитятся, см. .gitignore;
#     .env — тот же файл, из которого бот берёт BOT_TOKEN);
#   - для сборки на GitHub Actions: секрет репозитория VITE_DADATA_TOKEN.
#
# Важно: токен всё равно оказывается внутри собранного приложения (APK) — это
# клиентский ключ Дадаты, он виден любому, кто распаковывает APK. Секретный
# ключ (X-Secret) не нужен: он требуется только серверному методу clean/address,
# который из браузера не вызывается.
VITE_DADATA_TOKEN=

# Токен бота @fastcrm_bot.
#
# Нужен ТОЛЬКО локальному бот-лаунчеру (scripts/telegram-bot.mjs) и остаётся на
# вашей машине: в Mini App и в собранный бандл он не попадает. Переменной
# VITE_BOT_TOKEN быть не должно — всё с префиксом VITE_ уходит в JavaScript и
# становится доступно любому, кто откроет сайт.
#
# Файл .env не коммитится (см. .gitignore). Если токен попал в публичное место,
# перевыпустите его у @BotFather.
BOT_TOKEN=

# Адрес развёрнутого Cloudflare Worker (без /telegram/webhook): он нужен скрипту установки
# webhook — scripts/set-webhook.mjs. Значение вида
#   https://selfcrm-bot.<account>.workers.dev
# Записывается автоматически при первом запуске
#   npm run bot:webhook:set -- --url https://selfcrm-bot.<account>.workers.dev
WORKER_URL=

# Тот же адрес, но для Mini App: по нему отчёт в Excel уходит во временное хранилище
# (POST /files на Worker'е) и возвращается ссылкой на скачивание. Префикс VITE_ означает,
# что значение подставляется в собранный бандл — секрета в нём нет, адрес Worker'а и так
# виден в кнопке бота. Не задано — берётся адрес проекта из src/telegram/files.ts.
#
# Для сборки на GitHub Actions: переменная репозитория VITE_WORKER_URL (Settings →
# Secrets and variables → Actions → Variables). Задавать не обязательно.
#
# Если Worker развёрнут по другому адресу, его origin нужно добавить и в политику
# connect-src файла index.html: иначе браузер запретит запрос и пользователь увидит
# «нет связи с сервером выгрузки».
VITE_WORKER_URL=

# Секрет webhook: Telegram присылает его в заголовке X-Telegram-Bot-Api-Secret-Token,
# а Worker сверяет с этим значением. Секрет должен совпадать с секретом Worker в Cloudflare
# (npx wrangler secret put WEBHOOK_SECRET). Файл .env не коммитится.
# Создать и записать сюда случайный секрет: npm run bot:webhook:set (без --secret).
WEBHOOK_SECRET=

# Адрес Mini App, который открывает бот. По умолчанию — GitHub Pages проекта.
WEBAPP_URL=https://doc9830.github.io/selfcrm-tg/

